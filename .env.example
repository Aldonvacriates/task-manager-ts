# Copy to .env.local and fill in values from your Auth0 Single Page Application.
# If VITE_AUTH0_DOMAIN or VITE_AUTH0_CLIENT_ID is empty, the app runs without
# authentication (protected routes render directly; login is disabled).

VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id

# Optional: only needed if you call an Auth0-protected API.
VITE_AUTH0_AUDIENCE=

# Optional: default to window.location.origin when unset.
VITE_AUTH0_REDIRECT_URI=http://localhost:5173/callback
VITE_AUTH0_LOGOUT_URI=http://localhost:5173
